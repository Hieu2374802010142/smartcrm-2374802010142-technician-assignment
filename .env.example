
# SmartCRM L04 - Environment Configuration
# Demo environment for coursework testing only
# DO NOT use these credentials in production

# Manager account
# Demo username: manager
# Demo password: SmartCRM-Demo-2026!
SMARTCRM_ADMIN_USER=manager

# Password security (PBKDF2-HMAC-SHA256, 600000 iterations)
SMARTCRM_ADMIN_PASSWORD_SALT=<generated-salt>
SMARTCRM_ADMIN_PASSWORD_HASH=<generated-password-hash>

# Database: SQLite
# Docker database path: /data/smartcrm.db
# Database initialization: python3 -m src.backend.seed

# Backend: FastAPI
# Application URL: http://127.0.0.1:8000/app
# Health check URL: http://127.0.0.1:8000/health
